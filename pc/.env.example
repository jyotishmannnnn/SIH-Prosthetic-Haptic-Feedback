# Copy this file to pc/.env and fill in real values. .env is git-ignored
# (see .gitignore) -- never commit real Wi-Fi credentials, MAC addresses,
# or device names here.

# Default transport if --transport is not passed on the CLI. One of:
# usb, wifi, ble, espnow
TRANSPORT=usb

# --- Wi-Fi transport (transports/wifi.py) ---
# IP address of the Haptic ESP32 on your Wi-Fi network. NOT the PC's IP.
HAPTIC_WIFI_HOST=192.168.4.1
HAPTIC_WIFI_PORT=4210

# --- BLE transport (transports/bluetooth.py) ---
# Advertised BLE device name of the Haptic ESP32.
HAPTIC_BLE_DEVICE_NAME=HapticESP32

# Note: if a future Wi-Fi firmware needs the ESP32 to join YOUR network
# (station mode) rather than run its own access point, its SSID/password
# would also live here -- e.g. HAPTIC_WIFI_SSID / HAPTIC_WIFI_PASSWORD.
# Not used by the current transports/wifi.py (it assumes the ESP32 is
# already reachable at HAPTIC_WIFI_HOST, e.g. via its own SoftAP).
